# GPU-only OCR benchmark profile.
# Keep this separate from product `.env`.

TORCH_DEVICE=cuda
MINERU_DEVICE_MODE=cuda
CUDA_VISIBLE_DEVICES=0

# GTX 1650 4GB: conservative batches to avoid CUDA OOM.
MARKER_MAX_WORKERS=1
MARKER_EQUATION_BATCH=2
DETECTOR_BATCH_SIZE=2
LAYOUT_BATCH_SIZE=2
RECOGNITION_BATCH_SIZE=8
TABLE_REC_BATCH_SIZE=1
OCR_ERROR_BATCH_SIZE=2

# Benchmark should force OCR/LaTeX paths, not native text shortcuts.
MARKER_BENCHMARK_DISABLE_OCR=0
MINERU_METHOD=ocr
MINERU_BACKEND=pipeline

# Keep smoke benchmarks bounded. Use CLI `--timeout 0 --variants 1,3,full`
# only when you explicitly want to let full OCR runs finish.
OCR_BENCHMARK_PER_ENGINE_TIMEOUT=600
MARKER_BENCHMARK_PER_ENGINE_TIMEOUT=600
MINERU_BENCHMARK_PER_ENGINE_TIMEOUT=600
OCR_BENCHMARK_TIMEOUT_SECONDS=600
MARKER_BENCHMARK_TIMEOUT_SECONDS=600
MINERU_BENCHMARK_TIMEOUT_SECONDS=600
