# ==================== REQUIRED ====================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key

# ==================== OPTIONAL ====================
# Database (default: SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./math_parser.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Server
PORT=8000
ENV=development

# CORS (comma-separated origins)
# BACKEND_CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Document segmentation rollout
DOCUMENT_SEGMENTATION_ENABLED=0
DOCUMENT_SEGMENTATION_SHADOW=1

# Layout-aware review assets
ASSET_STORAGE_BACKEND=local
ASSET_LOCAL_DIR=media_uploads
# ASSET_STORAGE_BACKEND=s3
# ASSET_S3_BUCKET=
# ASSET_S3_ENDPOINT_URL=
# ASSET_S3_ACCESS_KEY_ID=
# ASSET_S3_SECRET_ACCESS_KEY=
# ASSET_S3_REGION=
# ASSET_PUBLIC_BASE_URL=

# Product OCR latency policy
OCR_TOTAL_TIMEOUT_BASE=120
OCR_TOTAL_TIMEOUT_PER_PAGE=60
OCR_TOTAL_TIMEOUT_CAP=1200
MARKER_TIMEOUT_BASE=120
MARKER_TIMEOUT_PER_PAGE=120
MARKER_TIMEOUT_CAP=600
MARKER_SUB_RETRY_PAGES=3
STEM_TEXT_PDF_FORCE_MARKER_MAX_PAGES=3
OCR_LATEX_MARKER_RESCUE_MAX_PAGES=3

# OCR benchmark flow (optional; production pipeline does not require these)
OCR_BENCHMARK_PER_ENGINE_TIMEOUT=600
OCR_BENCHMARK_TIMEOUT_SECONDS=300
MARKER_BENCHMARK_PER_ENGINE_TIMEOUT=600
MARKER_BENCHMARK_LOWRES_DPI=72
MARKER_BENCHMARK_HIGHRES_DPI=144
MARKER_BENCHMARK_EXTRACT_IMAGES=0
MARKER_BENCHMARK_DISABLE_OCR=auto
MINERU_METHOD=detect
OCR_NATIVE_MATH_FULL_MARKER_RESCUE=0

# OCR fallback cascade — PaddleOCR-VL khi MinerU lỗi/empty/low-quality (giữ LaTeX + tiếng Việt)
OCR_FALLBACK_ENABLED=1
OCR_FALLBACK_ENGINE=paddle-vl
PADDLE_USE_VL=1
# Chạy PaddleOCR-VL trên GPU. Dùng "auto" nếu muốn tự dò (fallback CPU khi không có GPU);
# "gpu" ép GPU (GTX 1650 4GB chạy được model 0.9B fp16 nhưng PDF nhiều trang có thể sát VRAM).
PADDLE_VL_DEVICE=gpu
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
CHANDRA_CMD=
OLMOCR_CMD=
MINERU_CMD=
MARKER_CMD=
PADDLE_CMD=
